  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HandoffInput": {
        "properties": {
          "session_id": {
            "type": "string",
            "title": "Session Id"
          }
        },
        "type": "object",
        "required": [
          "session_id"
        ],
        "title": "HandoffInput"
      },
      "MessageInput": {
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 4000,
            "minLength": 1,
            "title": "Text"
          },
          "client_message_id": {
            "type": "string",
            "maxLength": 100,
            "minLength": 8,
            "title": "Client Message Id"
          },
          "expected_profile_revision": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Expected Profile Revision"
          },
          "profile_patch": {
            "$ref": "#/components/schemas/ProfilePatch"
          },
          "channel": {
            "type": "string",
            "enum": [
              "h5",
              "mp_weixin",
              "mcp"
            ],
            "title": "Channel",
            "default": "h5"
          },
          "topic": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Topic"
          },
          "simulation_time": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Simulation Time"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "text",
          "client_message_id",
          "expected_profile_revision"
        ],
        "title": "MessageInput"
      },
      "ProfilePatch": {
        "properties": {
          "college": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "SAI",
                  "MARX",
                  "CSE",
                  "CYBER"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "College"
          },
          "program_level": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "undergraduate",
                  "master",
                  "doctor"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Program Level"
          },
          "study_mode": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "full_time",
                  "part_time"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Study Mode"
          },
          "degree_type": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "academic",
                  "professional"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Degree Type"
          },
          "cohort_year": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 2040.0,
                "minimum": 2000.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Cohort Year"
          },
          "year_of_study": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 10.0,
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Year Of Study"
          },
          "class_type": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "ordinary",
                  "self_strength"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Class Type"
          },
          "academic_rank_pct": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 100.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Academic Rank Pct"
          },
          "comprehensive_rank_pct": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 100.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Comprehensive Rank Pct"
          },
          "achievement_eligible": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Achievement Eligible"
          },
          "has_exclusion": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Has Exclusion"
          },
          "previous_leijun": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Previous Leijun"
          },
          "another_special_award": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Another Special Award"
          },
          "english_eligible": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "English Eligible"
          },
          "midterm_result": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "excellent",
                  "good",
                  "pass",
                  "fail"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Midterm Result"
          },
          "major": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 80
              },
              {
                "type": "null"
              }
            ],
            "title": "Major"
          },
          "achievements": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 600
              },
              {
                "type": "null"
              }
            ],
            "title": "Achievements"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "ProfilePatch"
      },
      "SessionInput": {
        "properties": {
          "topic": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Topic"
          }
        },
        "type": "object",
        "title": "SessionInput"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}